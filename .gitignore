# Python / virtualenv
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Secrets — never commit real keys; share .env.example instead
.env
**/.env

# OS cruft
.DS_Store
**/.DS_Store

# Personal study progress & private notes (keep your own; don't publish)
# These hold the full verbatim (official sample questions + task statements) for local study.
*.personal.ipynb
*.personal.md
personal/

# Claude Code local settings (machine-specific paths; never publish)
.claude/settings.local.json
**/settings.local.json

# Personal / superseded planning docs (kept locally, not published)
archive/

# Prisma generated client (regenerable via `npm run setup`; embeds absolute paths)
claude-with-anthropic-api/uigen/src/generated/

# Official Anthropic material — not redistributed; download from Anthropic (see README).
# Ignore everything under reference/ (guide text, course catalog) except its README.
ccaf-prep/reference/*
!ccaf-prep/reference/README.md
# All exam guides (Foundations AND Professional, any product), plus program policy/T&C PDFs.
*Exam*Guide*.pdf
*Certification_Exam_Policy*.pdf
*Certification_Terms_and_Conditions*.pdf
